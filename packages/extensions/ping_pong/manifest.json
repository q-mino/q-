                "type": "object",
                "properties": {
                  "event": { "type": "string", "const": "no_response" },
                  "payload": {
                    "type": "object",
                    "properties": { "ping_id": { "type": "string", "minLength": 1 } },
                    "required": ["ping_id"],
                    "additionalProperties": false
                  }
                },
                "required": ["event", "payload"],
                "additionalProperties": false
              },
              "the_peer_cannot_answer": {
                "type": "object",
                "properties": {
                  "event": { "type": "string", "const": "the_peer_cannot_answer" },
                  "payload": {
                    "type": "object",
                    "properties": { "ping_id": { "type": "string", "minLength": 1 } },
                    "required": ["ping_id"],
                    "additionalProperties": false
                  }
                },
                "required": ["event", "payload"],
                "additionalProperties": false
              },
              "the_wait_is_over": {
                "type": "object",
                "properties": {
                  "event": { "type": "string", "const": "the_wait_is_over" },
