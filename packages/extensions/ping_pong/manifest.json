                    "type": "string",
                    "pattern": "^-?\\d+(?:\\.\\d+)?\\.-?\\d+(?:\\.\\d+)?\\.-?\\d+(?:\\.\\d+)?$"
                  },
                  "oldest": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["event", "current", "oldest"],
