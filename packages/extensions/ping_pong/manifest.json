                  "event": { "type": "string", "const": "pong" },
                  "payload": {
                    "type": "object",
                    "properties": { "ping_id": { "type": "string", "minLength": 1 } },
                    "required": ["ping_id"],
                    "additionalProperties": false
                  }
                },
                "required": ["event", "payload"],
                "additionalProperties": false
              },
