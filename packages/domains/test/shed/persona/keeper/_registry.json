{
  "domain": "persona/keeper",
  "major": 1,
  "version": "1.0.0",
  "paths": {
    "persona/keeper/value/retirement_reason": {
      "kind": "value",
      "shapes": {
        "schema": {
          "direction": "carried",
          "schema": { "type": "string", "enum": ["broken", "lost", "worn_out", "given_away"] }
        }
      }
    },
    "persona/keeper/value/notes": {
      "kind": "value",
      "shapes": {
        "schema": { "direction": "carried", "schema": { "type": "string", "maxLength": 500 } }
      }
    },
    "persona/keeper/value/tool_name": {
      "kind": "value",
      "shapes": {
        "schema": { "direction": "carried", "schema": { "type": "string", "minLength": 1 } }
      }
    },
    "persona/keeper/value/category": {
      "kind": "value",
      "shapes": {
        "schema": {
          "direction": "carried",
          "schema": { "type": "string", "enum": ["garden", "power", "hand", "ladder"] }
        }
      }
    },
    "persona/keeper/value/number_of_loans": {
      "kind": "value",
      "shapes": {
        "schema": {
          "direction": "carried",
          "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    },
    "persona/keeper/node/keeper": { "kind": "node" },
    "persona/keeper/usecase/retire_a_tool": {
      "kind": "usecase",
      "shapes": {
        "event/the_tool_is_retired": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": {
              "tool_id": { "type": "string", "minLength": 1 },
              "date": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              }
            },
            "required": ["tool_id", "date"],
            "additionalProperties": false
          }
        },
        "event/the_tool_was_already_retired": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": { "tool_id": { "type": "string", "minLength": 1 } },
            "required": ["tool_id"],
            "additionalProperties": false
          }
        },
        "event/there_is_no_such_tool": {
          "direction": "given",
          "schema": { "type": "object", "properties": {}, "additionalProperties": false }
        }
      }
    },
    "persona/keeper/usecase/retire_a_tool_input": {
      "kind": "usecase",
      "shapes": {
        "schema": {
          "direction": "read",
          "schema": {
            "type": "object",
            "properties": {
              "tool_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "enum": ["broken", "lost", "worn_out", "given_away"] },
              "notes": { "type": "string", "maxLength": 500 }
            },
            "required": ["tool_id", "reason"],
            "additionalProperties": false
          }
        }
      }
    },
    "persona/keeper/usecase/send_a_tool_to_repair": {
      "kind": "usecase",
      "shapes": {
        "event/the_tool_is_in_the_workshop": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": {
              "tool_id": { "type": "string", "minLength": 1 },
              "since": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
              }
            },
            "required": ["tool_id", "since"],
            "additionalProperties": false
          }
        },
        "event/the_tool_was_already_in_the_workshop": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": { "tool_id": { "type": "string", "minLength": 1 } },
            "required": ["tool_id"],
            "additionalProperties": false
          }
        },
        "event/the_tool_is_retired": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": { "tool_id": { "type": "string", "minLength": 1 } },
            "required": ["tool_id"],
            "additionalProperties": false
          }
        },
        "event/there_is_no_such_tool": {
          "direction": "given",
          "schema": { "type": "object", "properties": {}, "additionalProperties": false }
        }
      }
    },
    "persona/keeper/usecase/send_a_tool_to_repair_input": {
      "kind": "usecase",
      "shapes": {
        "schema": {
          "direction": "read",
          "schema": {
            "type": "object",
            "properties": { "tool_id": { "type": "string", "minLength": 1 } },
            "required": ["tool_id"],
            "additionalProperties": false
          }
        }
      }
    },
    "persona/keeper/usecase/put_a_repaired_tool_back_in_service": {
      "kind": "usecase",
      "shapes": {
        "event/the_tool_is_back_in_service": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": { "tool_id": { "type": "string", "minLength": 1 } },
            "required": ["tool_id"],
            "additionalProperties": false
          }
        },
        "event/the_tool_is_not_in_the_workshop": {
          "direction": "given",
          "schema": { "type": "object", "properties": {}, "additionalProperties": false }
        }
      }
    },
    "persona/keeper/usecase/put_a_repaired_tool_back_in_service_input": {
      "kind": "usecase",
      "shapes": {
        "schema": {
          "direction": "read",
          "schema": {
            "type": "object",
            "properties": { "tool_id": { "type": "string", "minLength": 1 } },
            "required": ["tool_id"],
            "additionalProperties": false
          }
        }
      }
    },
    "persona/keeper/usecase/the_loans_of_the_month": {
      "kind": "usecase",
      "shapes": {
        "entry": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": {
              "tool_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "loans": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            },
            "required": ["tool_id", "name", "loans"],
            "additionalProperties": false
          }
        }
      }
    },
    "persona/keeper/usecase/the_loans_of_the_month_input": {
      "kind": "usecase",
      "shapes": {
        "schema": {
          "direction": "read",
          "schema": { "type": "object", "properties": {}, "additionalProperties": false }
        }
      }
    },
    "persona/keeper/usecase/load_tools_from_a_sheet": {
      "kind": "usecase",
      "shapes": {
        "event/the_sheet_is_being_loaded": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": {
              "lines": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
            },
            "required": ["lines"],
            "additionalProperties": false
          }
        },
        "event/the_tool_is_in_the_catalogue": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": { "tool_id": { "type": "string", "minLength": 1 } },
            "required": ["tool_id"],
            "additionalProperties": false
          }
        },
        "event/the_id_of_the_line_is_taken": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": {
              "line": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "tool_id": { "type": "string", "minLength": 1 }
            },
            "required": ["line", "tool_id"],
            "additionalProperties": false
          }
        },
        "event/the_sheet_is_loaded": {
          "direction": "given",
          "schema": { "type": "object", "properties": {}, "additionalProperties": false }
        },
        "event/the_sheet_cannot_be_loaded": {
          "direction": "given",
          "schema": { "type": "object", "properties": {}, "additionalProperties": false }
        }
      }
    },
    "persona/keeper/usecase/load_tools_from_a_sheet_input": {
      "kind": "usecase",
      "shapes": {
        "schema": {
          "direction": "read",
          "schema": {
            "type": "object",
            "properties": {
              "lines": {
                "minItems": 1,
                "maxItems": 5000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tool_id": { "type": "string", "minLength": 1 },
                    "name": { "type": "string", "minLength": 1 },
                    "category": { "type": "string", "enum": ["garden", "power", "hand", "ladder"] },
                    "notes": { "type": "string", "maxLength": 500 }
                  },
                  "required": ["tool_id", "name", "category"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["lines"],
            "additionalProperties": false
          }
        }
      }
    },
    "persona/keeper/usecase/load_tools_from_a_short_sheet": {
      "kind": "usecase",
      "shapes": {
        "event/the_sheet_is_loaded": {
          "direction": "given",
          "schema": {
            "type": "object",
            "properties": {
              "added": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "left": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "line": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "tool_id": { "type": "string", "minLength": 1 }
                  },
                  "required": ["line", "tool_id"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["added", "left"],
            "additionalProperties": false
          }
        },
        "event/the_sheet_cannot_be_loaded": {
          "direction": "given",
          "schema": { "type": "object", "properties": {}, "additionalProperties": false }
        }
      }
    },
    "persona/keeper/usecase/load_tools_from_a_short_sheet_input": {
      "kind": "usecase",
      "shapes": {
        "schema": {
          "direction": "read",
          "schema": {
            "type": "object",
            "properties": {
              "lines": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tool_id": { "type": "string", "minLength": 1 },
                    "name": { "type": "string", "minLength": 1 },
                    "category": { "type": "string", "enum": ["garden", "power", "hand", "ladder"] },
                    "notes": { "type": "string", "maxLength": 500 }
                  },
                  "required": ["tool_id", "name", "category"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["lines"],
            "additionalProperties": false
          }
        }
      }
    },
    "persona/keeper/version/keeper": { "kind": "version" }
  }
}
