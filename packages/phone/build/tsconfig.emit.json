{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "rootDir": "../..",
