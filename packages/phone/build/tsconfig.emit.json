  },
  "include": [
    "../src",
    "../../domains/src",
    "../../boundary/src",
    "../../adapters-common/src",
    "../../adapters-web/src",
    "../../memory/src",
    "../../extensions/ping_pong"
  ],
  "exclude": [
    "../src/sw",
    "../../extensions/ping_pong/test",
    "../../extensions/ping_pong/scripts",
    "../../extensions/ping_pong/node_modules"
  ]
}
