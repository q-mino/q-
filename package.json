{
  "name": "q-",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "graph": "depcruise packages --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm graph && pnpm test",
    "build": "pnpm --filter @q-mino/phone build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.18.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
